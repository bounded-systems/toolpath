{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolpath",
  "version": "0.1.0",
  "identifier": "dev.pathbase.toolpath-desktop",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "./frontend"
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "./frontend"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Toolpath",
        "width": 430,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "deb", "appimage"],
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Export agent traces as Toolpath documents",
    "longDescription": "Select Claude Code sessions, git branches, or GitHub PRs, preview the provenance DAG, and export to a local .path.json file or upload to Pathbase."
  }
}
